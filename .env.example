# MongoDB Atlas connection string.
# Use your OWN database name (mealmate_<firstname>) so you never overwrite teammates' data.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mealmate_<firstname>?retryWrites=true&w=majority"

# Auth.js secret used to sign the session JWT.
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"

# Base URL used in email links (password reset, email verification).
AUTH_URL="http://localhost:3000"

# Coach (Mia): free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional: Flash model to use first (falls back to other Flash models when busy).
GEMINI_MODEL="gemini-3.6-flash"

# Email (password reset + verification). Leave SMTP_PASSWORD empty in dev:
# emails are then printed in the `npm run dev` terminal instead of being sent.
# Gmail: create an app password at https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="MealMate <you@gmail.com>"
